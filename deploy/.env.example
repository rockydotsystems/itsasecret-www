# itsasecret self-hosted configuration.
# Copy to .env and edit:  cp .env.example .env
# docker compose reads .env from this directory automatically; every variable
# here is also passed into the web container.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Password for the bundled Postgres database. The database port is NOT
# published to the host, so this only guards the internal compose network.
# Generate one:  openssl rand -base64 24
POSTGRES_PASSWORD=

# Server-side wrapping secret: encrypts the few values the server must
# re-encrypt itself (pending invite org keys, env-var history). Minimum 32
# characters. If you rotate it, everything wrapped under the old value is
# unrecoverable - treat it like a database backup passphrase.
# Generate one:  openssl rand -base64 32
SERVER_WRAP_SECRET=

# ---------------------------------------------------------------------------
# Recommended
# ---------------------------------------------------------------------------

# Public origin of this instance - used to build links in emails
# (verification, invites). Falls back to the request's Host header when
# unset, but set it explicitly when running behind a reverse proxy.
#APP_URL=https://shh.example.com

# Host port the web app is published on (the container always listens on
# 3000).
#HTTP_PORT=3000

# If the app sits behind more than one proxy hop, set this so per-IP rate
# limiting reads the right address from X-Forwarded-For (default 1).
#TRUSTED_PROXY_COUNT=1

# ---------------------------------------------------------------------------
# Email - pick ONE option (without either, no email is sent at all)
# ---------------------------------------------------------------------------

# Option A: Resend (https://resend.com) - verification, invite, and team
# emails are delivered to users' inboxes.
#RESEND_API_KEY=re_xxxxxxxx
#EMAIL_FROM=itsasecret <shh@example.com>

# Option B: no email provider - verification and invite links print to the
# server log instead (`docker compose logs -f web`) and you hand them to
# users manually. Never use this on a shared-hosting deployment where logs
# are aggregated somewhere you don't control.
#EMAIL_DELIVERY=log

# Forward feedback-form submissions to this address (only with Resend).
#FEEDBACK_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Optional - hosted-service features, off by default
# ---------------------------------------------------------------------------

# Stripe billing. Without STRIPE_SECRET_KEY every org runs on free-plan
# limits and the checkout/portal endpoints are disabled.
#STRIPE_SECRET_KEY=sk_xxxxxxxx
#STRIPE_TEAM_PRICE_ID=price_xxxxxxxx
#STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# S3-compatible bucket that serves `shh` CLI binary downloads (/install.sh,
# /api/dl/*). Without these, the installer endpoints return 503 - install
# the CLI from source or GitHub releases instead.
#BUCKET_ENDPOINT=
#BUCKET_NAME=
#BUCKET_ACCESS_KEY_ID=
#BUCKET_SECRET_ACCESS_KEY=
#BUCKET_REGION=auto
